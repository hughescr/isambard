{
  "name": "isambard",
  "version": "0.1.0",
  "description": "AI-powered Discord bot with persistent memory using DynamoDB",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Craig Hughes",
  "repository": {
    "type": "git",
    "url": "https://github.com/hughescr/isambard.git"
  },
  "scripts": {
    "clones": "jscpd src/",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "deploy:running": "cd running && git fetch origin running && git reset --hard origin/running && bun install",
    "dev:sst": "sst shell -- bun --no-env-file --hot src/index.ts",
    "lint": "eslint --cache --format unix .",
    "lint:fix": "eslint --cache --fix --format overview .",
    "lint:overview": "eslint --cache --format overview .",
    "mutate": "stryker run",
    "sst-deploy": "sst deploy",
    "sst-dev": "sst dev",
    "sst-diagnostics": "sst diagnostic --print-logs \"$@\"",
    "sst-remove": "sst remove",
    "start": "bun run dev:sst",
    "test": "if [ -n \"$CI\" ]; then bun test --timeout 60; else bun test --timeout 5; fi",
    "test:full": "bun run lint;bun run typecheck;bun run mutate",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.76",
    "@atproto/api": "^0.19.3",
    "@aws-sdk/client-dynamodb": "^3.1010.0",
    "@aws-sdk/lib-dynamodb": "^3.1010.0",
    "@discordjs/builders": "^1.13.1",
    "@hughescr/logger": "^2.10.0",
    "@sapphire/snowflake": "^3.5.5",
    "@smithy/node-http-handler": "^4.5.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "env-var": "^7.5.0",
    "heic-convert": "^2.1.0",
    "html-to-text": "^9.0.5",
    "lodash-es": "^4.17.23",
    "luxon": "^3.7.2",
    "mrmime": "^2.0.1",
    "node-ical": "^0.25.6",
    "p-limit": "^7.3.0",
    "remove-markdown": "^0.6.3",
    "semver": "^7.7.4",
    "sst": "^4.3.5",
    "tsdav": "^2.1.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hughescr/eslint-config-default": "^5.1.0",
    "@hughescr/stryker-bun-runner": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@stryker-mutator/api": "^9.6.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@types/bun": "^1.3.10",
    "@types/heic-convert": "^2.1.0",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/remove-markdown": "^0.3.4",
    "@types/semver": "^7.7.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-formatter-overview": "^2.0.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.0",
    "eslint-plugin-package-json": "^0.91.0",
    "jscpd": "^4.0.8",
    "knip": "^5.87.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "aws-sdk"
  ],
  "engines": {
    "node": ">=23.0.0",
    "bun": ">=1.3.7"
  }
}
