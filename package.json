{
  "name": "isambard",
  "version": "0.1.0",
  "description": "AI-powered Discord bot with persistent memory using DynamoDB",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "author": "Craig Hughes",
  "repository": {
    "type": "git",
    "url": "https://github.com/hughescr/isambard.git"
  },
  "scripts": {
    "clones": "jscpd src/",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "deploy:running": "cd running && git fetch origin running && git reset --hard origin/running && bun install",
    "dev:sst": "sst shell -- bun --no-env-file --hot src/index.ts",
    "postinstall": "tools/setup-node-llama-cpp.sh",
    "lint": "eslint --cache --format unix .",
    "lint:fix": "eslint --cache --fix --format overview .",
    "lint:overview": "eslint --cache --format overview .",
    "mutate": "tools/run-stryker.sh",
    "mutate:wait": "tools/run-stryker.sh --wait",
    "sst-deploy": "sst deploy",
    "sst-dev": "sst dev",
    "sst-diagnostics": "sst diagnostic --print-logs \"$@\"",
    "sst-remove": "sst remove",
    "start": "bun run dev:sst",
    "test": "bun test ${CI:+--timeout 60}",
    "test:full": "bun run lint;bun run typecheck;bun run mutate",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@atproto/api": "^0.19.11",
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1037.0",
    "@discordjs/builders": "^1.14.1",
    "@hughescr/logger": "^2.10.0",
    "@sapphire/snowflake": "^3.5.5",
    "@smithy/node-http-handler": "^4.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.26.3",
    "env-var": "^7.5.0",
    "heic-convert": "^2.1.0",
    "html-to-text": "^9.0.5",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "mrmime": "^2.0.1",
    "node-ical": "^0.26.0",
    "node-llama-cpp": "^3.18.1",
    "p-limit": "^7.3.0",
    "remove-markdown": "^0.6.3",
    "semver": "^7.7.4",
    "sqlite-vec": "^0.1.9",
    "sst": "^4.12.2",
    "tsdav": "^2.1.8",
    "xstate": "^5.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hughescr/eslint-config-default": "^6.0.1",
    "@hughescr/eslint-plugin-module-boundaries": "^1.0.0",
    "@hughescr/eslint-plugin-test-hygiene": "^1.0.0",
    "@hughescr/stryker-bun-runner": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bun": "^1.3.13",
    "@types/heic-convert": "^2.1.0",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/picomatch": "^4.0.3",
    "@types/remove-markdown": "^0.3.4",
    "@types/semver": "^7.7.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.2.1",
    "eslint-formatter-overview": "^2.0.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-package-json": "^0.91.1",
    "jscpd": "^4.0.9",
    "knip": "^6.7.0",
    "picomatch": "^4.0.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "discord-api-types": "0.38.42"
  },
  "trustedDependencies": [
    "aws-sdk"
  ],
  "engines": {
    "node": ">=23.0.0",
    "bun": ">=1.3.12"
  }
}
