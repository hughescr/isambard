{
  "name": "isambard",
  "version": "0.1.0",
  "description": "AI-powered Discord bot with persistent memory using DynamoDB",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev:docker": "docker compose -f docker/docker-compose.yml up --build",
    "dev:sst": "bunx sst shell -- bun --watch src/index.ts",
    "lint": "eslint --cache --format unix .",
    "lint:fix": "eslint --cache --fix --format overview .",
    "lint:overview": "eslint --cache --format overview .",
    "mutate": "bunx stryker run",
    "sst-deploy": "bunx sst deploy",
    "sst-dev": "bunx sst dev",
    "sst-diagnostics": "bunx sst diagnostic --print-logs \"$@\"",
    "sst-remove": "bunx sst remove",
    "start": "bun run dev:sst",
    "test": "if [ -n \"$CI\" ]; then bun test --timeout 30; else bun test --timeout 5; fi",
    "test:full": "bun run lint;bun run typecheck;bun run mutate",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.3",
    "@aws-sdk/client-dynamodb": "3.966.0",
    "@aws-sdk/lib-dynamodb": "3.966.0",
    "@hughescr/logger": "2.7.2",
    "@sapphire/snowflake": "3.5.5",
    "date-fns": "4.1.0",
    "discord.js": "14.25.1",
    "p-limit": "7.2.0",
    "remove-markdown": "0.6.2",
    "semver": "7.7.3",
    "sst": "3.17.25",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@hughescr/eslint-config-default": "4.0.1",
    "@hughescr/stryker-bun-runner": "link:@hughescr/stryker-bun-runner",
    "@stryker-mutator/core": "9.4.0",
    "@stryker-mutator/typescript-checker": "9.4.0",
    "@types/bun": "1.3.5",
    "@types/remove-markdown": "0.3.4",
    "@types/semver": "7.7.1",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "9.39.2",
    "eslint-formatter-overview": "2.0.0",
    "eslint-formatter-unix": "9.0.1",
    "eslint-plugin-package-json": "0.88.1",
    "typescript": "5.9.3"
  }
}
